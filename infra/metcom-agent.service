[Unit]
Description=METCOM Discord nutrition agent
Documentation=https://github.com/jack-kenney/AGENT
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=metcom-agent
Group=metcom-agent
WorkingDirectory=/opt/metcom-agent/app
EnvironmentFile=/etc/metcom-agent/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=METCOM_DB_PATH=/var/lib/metcom-agent/metcom.db
ExecStart=/opt/metcom-agent/venv/bin/python /opt/metcom-agent/app/agent_bot.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/metcom-agent

[Install]
WantedBy=multi-user.target
